generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id         Int            @id @default(autoincrement())
  name       String
  location   String
  createdAt  DateTime       @default(now())
  feedbacks  Feedback[]
  categories MenuCategory[]
  orders     Order[]
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  menuItems MenuItem[]
}

model MenuItem {
  id              Int          @id @default(autoincrement())
  name            String
  price           Float
  available       Boolean      @default(true)
  categoryId      Int
  createdAt       DateTime     @default(now())
  description     String?
  preparationTime Int          @default(10)
  imageUrl        String?
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
}

model Order {
  id              Int         @id @default(autoincrement())
  status          OrderStatus @default(PLACED)
  totalAmount     Float
  createdAt       DateTime    @default(now())
  branchId        Int
  tokenNumber     Int?
  collectedAt     DateTime?
  notes           String?
  readyAt         DateTime?
  startedAt       DateTime?
  orderSource     OrderSource @default(QR)
  placedAt        DateTime?
  idempotencyKey  String?     @unique
  paymentRequired Boolean     @default(false)
  feedback        Feedback?
  branch          Branch      @relation(fields: [branchId], references: [id])
  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  orderId    Int
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id               Int                  @id @default(autoincrement())
  orderId          Int
  amount           Float
  status           PaymentStatus        @default(PENDING)
  method           PaymentMethod?
  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  refundedAmount   Float                @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  refundedAt       DateTime?
  webhookEventId   String?              @unique
  idempotencyKey   String?              @unique
  expiresAt        DateTime?
  order            Order                @relation(fields: [orderId], references: [id])
  refunds          PaymentRefund[]
  transactions     PaymentTransaction[]

  @@index([orderId])
  @@index([status])
  @@index([gatewayPaymentId])
  @@index([status, expiresAt])
}

model PaymentTransaction {
  id               Int                  @id @default(autoincrement())
  paymentId        Int
  gatewayPaymentId String               @unique
  status           GatewayPaymentStatus @default(PENDING)
  amountMinor      Int
  currency         String               @default("INR")
  method           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  refundRequestKey String?              @unique
  payment          Payment              @relation(fields: [paymentId], references: [id])

  @@index([paymentId, status])
  @@index([status])
}

model PaymentRefund {
  id              Int                 @id @default(autoincrement())
  paymentId       Int
  idempotencyKey  String              @unique
  gatewayRefundId String?             @unique
  amountMinor     Int
  currency        String              @default("INR")
  status          RefundAttemptStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  processedAt     DateTime?
  payment         Payment             @relation(fields: [paymentId], references: [id])

  @@index([paymentId, status])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  orderId   Int      @unique
  branchId  Int
  createdAt DateTime @default(now())
  source    String   @default("CUSTOMER")
  branch    Branch   @relation(fields: [branchId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
}

model DailyTokenCounter {
  id          Int      @id @default(autoincrement())
  counterDate DateTime @unique
  lastToken   Int
}

model WebhookEvent {
  id                 Int                @id @default(autoincrement())
  gateway            String
  eventType          String
  externalEventId    String?
  gatewayPaymentId   String?
  gatewayOrderId     String?
  status             WebhookEventStatus @default(RECEIVED)
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?
  processingAttempts Int                @default(0)
  lastError          String?

  @@unique([gateway, externalEventId])
  @@index([gateway, gatewayPaymentId])
  @@index([gateway, gatewayOrderId])
  @@index([status, receivedAt])
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  COLLECTED
  PENDING_PAYMENT
  PAYMENT_ABANDONED
}

enum OrderSource {
  QR
  COUNTER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  PROCESSING
  TIMED_OUT
}

enum GatewayPaymentStatus {
  PENDING
  AUTHORIZED
  FAILED
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  OTHER
}
