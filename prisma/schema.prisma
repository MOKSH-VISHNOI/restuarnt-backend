generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id         Int            @id @default(autoincrement())
  name       String
  location   String
  createdAt  DateTime       @default(now())
  categories MenuCategory[]
  orders     Order[]
  feedbacks  Feedback[]
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  menuItems MenuItem[]
}

model MenuItem {
  id              Int          @id @default(autoincrement())
  name            String
  price           Float
  available       Boolean      @default(true)
  categoryId      Int
  createdAt       DateTime     @default(now())
  description     String?
  imageUrl        String?
  preparationTime Int          @default(10)
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
}

model Order {
  id          Int         @id @default(autoincrement())
  status      OrderStatus @default(PLACED)
  totalAmount Float
  createdAt   DateTime    @default(now())
  placedAt    DateTime?
  branchId    Int
  tokenNumber Int?
  orderSource OrderSource @default(QR)
  idempotencyKey String? @unique
  paymentRequired Boolean @default(false)

  collectedAt DateTime?
  notes       String?
  readyAt     DateTime?
  startedAt   DateTime?
  branch      Branch      @relation(fields: [branchId], references: [id])
  items       OrderItem[]
  feedback    Feedback?
  payments    Payment[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  orderId    Int
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  amount Float

  status PaymentStatus  @default(PENDING)
  method PaymentMethod?

  gateway          String?
  gatewayOrderId   String?
  gatewayPaymentId String?

  idempotencyKey String? @unique
  webhookEventId String? @unique

  transactions PaymentTransaction[]
  refunds      PaymentRefund[]

  refundedAmount Float @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  refundedAt DateTime?
  expiresAt  DateTime?

  @@index([orderId])
  @@index([status])
  @@index([gatewayPaymentId])
  @@index([status, expiresAt])
}

model PaymentTransaction {
  id               Int                  @id @default(autoincrement())
  paymentId        Int
  payment          Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  gatewayPaymentId String               @unique
  refundRequestKey String?              @unique
  status           GatewayPaymentStatus @default(PENDING)
  amountMinor      Int
  currency         String               @default("INR")
  method           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([paymentId, status])
  @@index([status])
}

model PaymentRefund {
  id              Int                 @id @default(autoincrement())
  paymentId       Int
  payment         Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey  String              @unique
  gatewayRefundId String?             @unique
  amountMinor     Int
  currency        String              @default("INR")
  status          RefundAttemptStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  processedAt     DateTime?

  @@index([paymentId, status])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  orderId   Int      @unique
  branchId  Int
  source    String   @default("CUSTOMER")
  createdAt DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_ABANDONED
  PLACED
  PREPARING
  READY
  COLLECTED
}

enum OrderSource {
  QR
  COUNTER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  TIMED_OUT
  REFUNDED
  PARTIALLY_REFUNDED
}

enum GatewayPaymentStatus {
  PENDING
  AUTHORIZED
  FAILED
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  OTHER
}

model DailyTokenCounter {
  id Int @id @default(autoincrement())

  counterDate DateTime @unique

  lastToken Int
}

model WebhookEvent {
  id Int @id @default(autoincrement())

  gateway   String
  eventType String

  // Gateway-provided event ID, if available.
  externalEventId String?

  // Payment and order identifiers extracted from the payload.
  gatewayPaymentId String?
  gatewayOrderId   String?

  status WebhookEventStatus @default(RECEIVED)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  processingAttempts Int     @default(0)
  lastError          String?

  @@unique([gateway, externalEventId])
  @@index([gateway, gatewayPaymentId])
  @@index([gateway, gatewayOrderId])
  @@index([status, receivedAt])
}
