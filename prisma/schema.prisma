generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id         Int            @id @default(autoincrement())
  name       String
  location   String
  createdAt  DateTime       @default(now())
  categories MenuCategory[]
  orders     Order[]
  feedbacks  Feedback[]
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  menuItems MenuItem[]
}

model MenuItem {
  id              Int          @id @default(autoincrement())
  name            String
  price           Float
  available       Boolean      @default(true)
  categoryId      Int
  createdAt       DateTime     @default(now())
  description     String?
  imageUrl        String?
  preparationTime Int          @default(10)
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
}

model Order {
  id          Int         @id @default(autoincrement())
  status      OrderStatus @default(PLACED)
  totalAmount Float
  createdAt   DateTime    @default(now())
  placedAt     DateTime?
  branchId    Int
  tokenNumber Int?
  orderSource OrderSource @default(QR)

  collectedAt DateTime?
  notes       String?
  readyAt     DateTime?
  startedAt   DateTime?
  branch      Branch      @relation(fields: [branchId], references: [id])
  items       OrderItem[]
  feedback    Feedback?
  payments Payment[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  orderId    Int
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  amount Float

  status PaymentStatus @default(PENDING)
  method PaymentMethod?

  gateway String?
  gatewayOrderId String?
  gatewayPaymentId String?

  refundedAmount Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refundedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([gatewayPaymentId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  orderId   Int      @unique
  branchId  Int
  source    String   @default("CUSTOMER")
  createdAt DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PREPARING
  READY
  COLLECTED
}

enum OrderSource {
  QR
  COUNTER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  OTHER
}

model DailyTokenCounter {
  id Int @id @default(autoincrement())

  counterDate DateTime @unique

  lastToken Int
}
